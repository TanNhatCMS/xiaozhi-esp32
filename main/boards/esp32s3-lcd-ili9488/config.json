{
    "target": "esp32s3",
    "builds": [
        {
            "name": "esp32s3-lcd-ili9488",
            "sdkconfig_append": [
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"main/boards/esp32s3-lcd-ili9488/partitions_16m.csv\"",
                "CONFIG_COMPILER_OPTIMIZATION_SIZE=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_LANGUAGE_VI_VN=y",
                "CONFIG_LVGL_USE_GIF=y",
                "CONFIG_SR_MN_EN_MULTINET6_QUANT=y",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"Hi Lily\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"Hi Lily\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20",
                "CONFIG_SEND_WAKE_WORD_DATA=y",
                "CONFIG_USE_AUDIO_PROCESSOR=y"
            ]
        }
    ]
}